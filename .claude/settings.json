{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "permissions": {
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git * push *--force*)",
      "Bash(git * push * -f*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git * commit *--no-verify*)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git config *core.hooksPath*)",
      "Bash(sudo *)",

      "Read(//mnt/d/data/MIMIC*/**)",
      "Read(//mnt/d/data/eicu/**)",
      "Read(//mnt/d/data/INSPIRE/**)",
      "Read(//mnt/d/data/vitaldb/**)",
      "Read(//mnt/d/data/PIC/**)",
      "Read(~/data/MIMIC*/**)",
      "Read(~/data/eicu/**)",
      "Read(~/data/INSPIRE/**)",
      "Read(~/data/vitaldb/**)",
      "Read(~/data/PIC/**)",
      "Read(//**/mimic_*.csv)",
      "Read(//**/eicu_*.csv)",
      "Read(//**/wave_windows_*.csv)",
      "Read(//**/inspire_traj*.csv)",
      "Read(//**/*.nii.gz)",
      "Bash(head *mimic_*)",
      "Bash(tail *mimic_*)",
      "Bash(cat *mimic_*)",
      "Bash(less *mimic_*)",
      "Bash(head *eicu_*)",
      "Bash(tail *eicu_*)",
      "Bash(cat *eicu_*)",
      "Bash(head *wave_windows_*)",
      "Bash(cat *wave_windows_*)",
      "Bash(head *inspire_traj*)",
      "Bash(cat *inspire_traj*)",

      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(//**/.env)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(rm -rf *)"
    ]
  }
}
